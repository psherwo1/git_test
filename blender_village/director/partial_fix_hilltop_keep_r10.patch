+def _eave_cover_fn(obs, q_max=0.6, probe=0.08):
+    """kit 1.6.0: refine the turret's analytic thatch-cover cull in the eave zone (q < q_max) against the thatch
+    actually built: a stone centre is culled only if the thatch probe-metres outside it (radially from the turret)
+    stands above it; otherwise it is kept (no open joints / holes above a roll lower than thatch_low)."""
+    from mathutils import Vector
+    from mathutils.bvhtree import BVHTree
+    dg = bpy.context.evaluated_depsgraph_get()
+    trees = [BVHTree.FromObject(o, dg) for o in obs if o is not None]
+    cx, cy = FR.TUR_C
+
+    def fn(C, bad):
+        C = np.asarray(C, float)
+        bad = np.array(bad, bool, copy=True)
+        flat = C.reshape(-1, 3)
+        bf = bad.reshape(-1)
+        zone = bf & (eave_q(flat[:, 0], flat[:, 1]) < q_max)
+        for i in np.flatnonzero(zone):
+            x, y, z = flat[i]
+            dx, dy = x - cx, y - cy
+            rr = math.hypot(dx, dy) + 1e-9
+            px, py = x + dx / rr * probe, y + dy / rr * probe
+            top = None
+            for tr in trees:
+                hit = tr.ray_cast(Vector((px, py, z + 0.6)), Vector((0, 0, -1.0)), 1.2)
+                if hit[0] is not None and (top is None or hit[0].z > top):
+                    top = hit[0].z
+            if top is None or top < z + 0.01:
+                bf[i] = False
+        return bf.reshape(bad.shape)
+    return fn
 
 
