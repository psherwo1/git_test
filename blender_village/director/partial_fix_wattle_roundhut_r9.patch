+        n = len(P)
+        a, b, c = P[i - 1], P[i], P[(i + 1) % n]
+        u = (a - b) / max(np.linalg.norm(a - b), 1e-9)
+        v = (c - b) / max(np.linalg.norm(c - b), 1e-9)
+        la = min(leg, 0.45 * np.linalg.norm(a - b))
+        lc = min(leg, 0.45 * np.linalg.norm(c - b))
